# URL pública del sitio (SEO, OG, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (opcionales)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# —— Formulario de contacto (/api/contact) ——
# Elige UNA de estas dos opciones:

# Opción A (recomendada, gratis): https://web3forms.com → Access Key
WEB3FORMS_ACCESS_KEY=

# Opción B: https://resend.com → API Key
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Destino de los mensajes (por defecto isra31987@gmail.com)
CONTACT_TO_EMAIL=isra31987@gmail.com
