# URL pública del sitio (SEO, OG, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (opcionales)
# Vercel Web Analytics: se activa en el dashboard del proyecto (no necesita env).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# —— Formulario de contacto ——
# Opción A (recomendada, gratis): https://web3forms.com
# La clave es pública a propósito: Web3Forms free solo acepta envíos desde el navegador.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Opción B (servidor): https://resend.com → API Key
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# CONTACT_TO_EMAIL=isra31987@gmail.com

# —— Chatbot de reclutamiento (Gemini) ——
# Clave en https://aistudio.google.com/apikey — solo servidor, nunca NEXT_PUBLIC_
GEMINI_API_KEY=
# Opcional (por defecto gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
